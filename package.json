{
  "name": "decentralized-lottery-dapp",
  "version": "1.0.0",
  "description": "A decentralized lottery application on Ethereum Sepolia testnet",
  "main": "truffle-config.js",
  "scripts": {
    "test": "truffle test",
    "compile": "truffle compile",
    "migrate": "truffle migrate",
    "migrate:sepolia": "truffle migrate --network sepolia",
    "serve": "serve frontend",
    "deploy": "gh-pages -d frontend",
    "dev": "lite-server -c bs-config.json",
    "deploy:local": "node scripts/deploy-and-configure.js",
    "update-config": "node scripts/update-config.js"
  },
  "keywords": [
    "ethereum",
    "blockchain",
    "lottery",
    "dapp",
    "smart-contract",
    "web3"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@truffle/hdwallet-provider": "^2.1.5",
    "dotenv": "^16.5.0",
    "web3": "^1.10.0"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "gh-pages": "^5.0.0",
    "lite-server": "^2.6.1",
    "serve": "^14.2.0",
    "truffle": "^5.8.1",
    "truffle-assertions": "^0.9.2"
  }
}
