  "keywords": [
    "ethereum",
    "blockchain",
    "solidity",
    "web3",
    "lottery"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "web3": "^1.10.0"
  },
  "devDependencies": {
    "lite-server": "^2.6.1"
  }
}
